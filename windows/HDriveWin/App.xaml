<Application
    x:Class="HDriveWin.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HDriveWin">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Global Accent and Fluent Brushes -->
            <SolidColorBrush x:Key="HDriveAccentBrush" Color="#4F46E5" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#E81123" />

            <!-- SubtleButtonStyle Fallback -->
            <Style x:Key="SubtleButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
