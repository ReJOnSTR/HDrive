<ContentDialog
    x:Class="HDriveWin.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Cloudreve Bağlantı ve Eşitleme Ayarları"
    PrimaryButtonText="Kaydet ve Bağlan"
    CloseButtonText="Kapat"
    DefaultButton="Primary">

    <StackPanel Spacing="16" Width="440" Margin="0,8,0,0">
        <!-- Sunucu Bilgileri Kartı -->
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Text="WebDAV Sunucu Bilgileri" FontWeight="SemiBold" />
                
                <TextBox x:Name="ServerUrlBox" Header="Sunucu Adresi (WebDAV)" 
                         PlaceholderText="http://sunucu:5212/dav" />
                
                <TextBox x:Name="UsernameBox" Header="Kullanıcı Adı / E-posta" 
                         PlaceholderText="admin@example.com" />
                
                <PasswordBox x:Name="PasswordBox" Header="WebDAV Şifresi" 
                             PlaceholderText="WebDAV şifreniz" />

                <Button x:Name="TestButton" Content="Bağlantıyı Test Et" Click="TestButton_Click" />
                
                <InfoBar x:Name="TestResultInfoBar" IsOpen="False" Severity="Informational" />
            </StackPanel>
        </Border>

        <!-- Yerel Eşitleme (OneDrive Modu) Kartı -->
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <StackPanel Spacing="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Yerel Klasör Eşitleme (OneDrive Modu)" FontWeight="SemiBold" />
                        <TextBlock Text="Dosyalarınızı Windows Gezgini'nde 'HDrive - Cloudreve' klasöründe tutar."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="SyncToggle" Grid.Column="1" Toggled="SyncToggle_Toggled" OnContent="" OffContent="" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button Content="📁 Dosya Gezgini'nde Aç" Click="OpenFolder_Click" />
                    <Button Content="🔄 Şimdi Eşitle" Click="SyncNow_Click" />
                </StackPanel>

                <TextBlock x:Name="SyncStatusText" Text="Durum: Hazır"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>
