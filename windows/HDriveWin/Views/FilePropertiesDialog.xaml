<ContentDialog
    x:Class="HDriveWin.Views.FilePropertiesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Özellikler"
    CloseButtonText="Kapat"
    DefaultButton="Close">

    <StackPanel Spacing="16" Width="380" Margin="0,8,0,0">
        <!-- Başlık ve İkon -->
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                <Border Width="48" Height="48" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid>
                        <Image x:Name="PropIconImage" Width="40" Height="40" Stretch="Uniform" />
                        <FontIcon x:Name="PropGlyphIcon" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock x:Name="PropFileName" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PropFileType" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Detay Bilgileri Tablosu -->
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="110,*" RowSpacing="12">
                <!-- Konum -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Konum:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="PropLocation" Grid.Row="0" Grid.Column="1" Text="--" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />

                <!-- Boyut -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Boyut:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="PropSize" Grid.Row="1" Grid.Column="1" Text="--" FontSize="12" VerticalAlignment="Center" />

                <!-- Değiştirilme -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Değiştirilme:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="PropModified" Grid.Row="2" Grid.Column="1" Text="--" FontSize="12" VerticalAlignment="Center" />

                <!-- Depolama -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Depolama:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#107C41" />
                    <TextBlock Text="Cloudreve Bulutunda Mevcut" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Hızlı Eylemler -->
        <Button x:Name="CopyPathButton" Content="Bulut Yolunu Kopyala" HorizontalAlignment="Stretch" Click="CopyPathButton_Click" />
    </StackPanel>
</ContentDialog>
