<Window
    x:Class="HDriveWin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:HDriveWin.Models"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d"
    Title="HDrive">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Özel Başlık Çubuğu (TitleBar) -->
            <RowDefinition Height="40" />
            <!-- 1: Ana İçerik ve Gezinti Çubuğu -->
            <RowDefinition Height="*" />
            <!-- 2: Durum Çubuğu -->
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- 0: Windows 11 Başlık Çubuğu & Sekmeler (TabView - Birebir Windows 11 Dosya Gezgini Sekme Şekli & Animasyonu) -->
        <Grid Grid.Row="0" VerticalAlignment="Stretch" Height="40">
            <!-- Windows 11 Sekmeler (Sol kenardan 8px, eşit genişlik animasyonu, hover kapat butonu) -->
            <TabView x:Name="ExplorerTabs"
                     Margin="8,0,0,0"
                     VerticalAlignment="Stretch"
                     TabWidthMode="Equal"
                     CloseButtonOverlayMode="OnPointerOver"
                     IsAddTabButtonVisible="True"
                     CanDragTabs="True"
                     CanReorderTabs="True"
                     AddTabButtonClick="ExplorerTabs_AddTabButtonClick"
                     TabCloseRequested="ExplorerTabs_TabCloseRequested"
                     SelectionChanged="ExplorerTabs_SelectionChanged">
                <TabView.Resources>
                    <!-- Windows 11 Dosya Gezgini Sekme Ölçüleri ve Köşe Yuvarlaklığı -->
                    <x:Double x:Key="TabViewItemHeaderMinHeight">34</x:Double>
                    <x:Double x:Key="TabViewItemHeaderMinWidth">130</x:Double>
                    <x:Double x:Key="TabViewItemHeaderMaxWidth">240</x:Double>
                    <CornerRadius x:Key="TabViewItemCornerRadius">7,7,0,0</CornerRadius>
                    <CornerRadius x:Key="OverlayCornerRadius">7,7,0,0</CornerRadius>
                </TabView.Resources>
                <TabView.TabStripFooter>
                    <!-- Drag Region: Sekmelerden sonraki boş alan pencereyi sürüklemek için kullanılır. MinWidth 188px sistem butonlarını korur -->
                    <Grid x:Name="CustomDragRegion" Background="Transparent" MinWidth="188" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </TabView.TabStripFooter>
            </TabView>
        </Grid>

        <!-- 1: NavigationView (Windows 11 Sol Kenar Çubuğu ve İçerik) -->
        <NavigationView x:Name="NavView" Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        AllowDrop="True"
                        DragOver="NavView_DragOver"
                        Drop="NavView_Drop"
                        ItemInvoked="NavView_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="AllFilesNavItem" Content="Tüm Dosyalar" Tag="cloud">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE753;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader x:Name="FavoritesHeader" Content="Favoriler" />
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <!-- Sabit Alt Depolama Alanı (Sticky Quota Footer) -->
                <Border Padding="14,10,14,12" 
                        BorderThickness="0,1,0,0" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEDA2;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Depolama" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="StorageQuotaPercentText" Text="%0" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <ProgressBar x:Name="StorageQuotaProgressBar" Value="0" Maximum="100" Height="4" CornerRadius="2" />

                        <Grid>
                            <TextBlock x:Name="StorageQuotaDetailText" Text="-- / --" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <Button x:Name="RefreshQuotaButton" Click="RefreshQuotaButton_Click" ToolTipService.ToolTip="Depolama bilgisini yenile"
                                    HorizontalAlignment="Right" Padding="4,2" Background="Transparent" BorderThickness="0" CornerRadius="4">
                                <FontIcon Glyph="&#xE72C;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>

            <!-- Gezinti Çubuğu İçeriği -->
            <Grid Margin="12,0,12,12">
                <Grid.RowDefinitions>
                    <!-- 0: Windows 11 Adres & Arama Çubuğu Satırı -->
                    <RowDefinition Height="Auto" />
                    <!-- 1: Komut Çubuğu (CommandBar / Şerit) -->
                    <RowDefinition Height="Auto" />
                    <!-- 2: Dosya Listesi -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 0: Windows 11 Adres Çubuğu & Arama Satırı (Tam Klasör Tasarımı) -->
                <Grid Grid.Row="0" Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <!-- Geri / İleri / Yukarı / Yenile Butonları -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Adres / Breadcrumb Bar (Esneyen) -->
                        <ColumnDefinition Width="*" />
                        <!-- Arama Kutusu -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Windows 11 Tarzı Gezinti Butonları (< > ^ ↻) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Button x:Name="BackButton" Click="BackButton_Click" IsEnabled="False" 
                                ToolTipService.ToolTip="Geri (Alt + Sol Ok)" Width="32" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <FontIcon Glyph="&#xE72B;" FontSize="12" />
                        </Button>
                        <Button x:Name="ForwardButton" Click="ForwardButton_Click" IsEnabled="False" 
                                ToolTipService.ToolTip="İleri (Alt + Sağ Ok)" Width="32" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <FontIcon Glyph="&#xE72A;" FontSize="12" />
                        </Button>
                        <Button x:Name="UpButton" Click="UpButton_Click" IsEnabled="False" 
                                ToolTipService.ToolTip="Üst Klasör (Alt + Yukarı Ok)" Width="32" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <FontIcon Glyph="&#xE74A;" FontSize="12" />
                        </Button>
                        <Button x:Name="NavRefreshButton" Click="RefreshButton_Click"
                                ToolTipService.ToolTip="Yenile (F5)" Width="32" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        </Button>
                    </StackPanel>

                    <!-- Adres Çubuğu Kutusu (Windows 11 File Explorer Birebir Tasarım) -->
                    <Border Grid.Column="1" 
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,0,8,0"
                            VerticalAlignment="Center"
                            Height="32">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="13" 
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" 
                                      Margin="0,0,6,0" VerticalAlignment="Center" />
                            <BreadcrumbBar x:Name="PathBreadcrumbBar" Grid.Column="1" 
                                           ItemClicked="PathBreadcrumbBar_ItemClicked"
                                           VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Windows 11 Arama Çubuğu -->
                    <AutoSuggestBox x:Name="SearchBox" 
                                    Grid.Column="2"
                                    Width="240"
                                    Height="32"
                                    Margin="6,0,0,0"
                                    PlaceholderText="HDrive içinde ara"
                                    QueryIcon="Find"
                                    VerticalAlignment="Center"
                                    CornerRadius="4"
                                    TextChanged="SearchBox_TextChanged"
                                    QuerySubmitted="SearchBox_QuerySubmitted"
                                    LostFocus="SearchBox_LostFocus" />
                </Grid>

                <!-- 1: Komut Çubuğu (Windows 11 Komut Şeridi & Üç Nokta Menüsü) -->
                <CommandBar Grid.Row="1" Background="Transparent" DefaultLabelPosition="Right" Margin="0,0,0,4" HorizontalAlignment="Left">
                    <AppBarButton Icon="NewFolder" Label="Yeni Klasör" Click="NewFolderButton_Click" />
                    <AppBarButton Icon="Upload" Label="Yükle" Click="UploadButton_Click" />
                    <AppBarButton Icon="Delete" Label="Sil" Click="ContextDelete_Click" ToolTipService.ToolTip="Seçili öğeleri sil (Delete)" />
                    <AppBarSeparator />
                    <AppBarButton Icon="View" Label="Görünüm">
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <ToggleMenuFlyoutItem x:Name="ViewLargeItem" Text="Büyük Simgeler" IsChecked="True" Click="ViewLarge_Click">
                                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE80A;" /></ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <ToggleMenuFlyoutItem x:Name="ViewMediumItem" Text="Orta Simgeler" Click="ViewMedium_Click">
                                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE7F4;" /></ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <ToggleMenuFlyoutItem x:Name="ViewDetailsItem" Text="Ayrıntılar" Click="ViewDetails_Click">
                                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C0;" /></ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarButton Label="Sırala">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8CB;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <ToggleMenuFlyoutItem x:Name="SortByNameItem" Text="Ad" IsChecked="True" Click="SortByName_Click" />
                                <ToggleMenuFlyoutItem x:Name="SortByDateItem" Text="Değiştirilme Tarihi" Click="SortByDate_Click" />
                                <ToggleMenuFlyoutItem x:Name="SortBySizeItem" Text="Boyut" Click="SortBySize_Click" />
                                <ToggleMenuFlyoutItem x:Name="SortByTypeItem" Text="Tür" Click="SortByType_Click" />
                                <MenuFlyoutSeparator />
                                <ToggleMenuFlyoutItem x:Name="SortAscItem" Text="Artan" IsChecked="True" Click="SortAscending_Click" />
                                <ToggleMenuFlyoutItem x:Name="SortDescItem" Text="Azalan" Click="SortDescending_Click" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarToggleButton x:Name="PreviewPaneToggle" Icon="PreviewLink" Label="Önizleme" Click="PreviewPaneToggle_Click" />
                    <AppBarButton x:Name="TransferButton" Label="Transferler" Click="TransferButton_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE896;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <Flyout x:Name="TransferFlyout" Placement="Bottom">
                                <Grid Width="360" MaxHeight="420">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Başlık & Temizle -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock Text="Transfer Kuyruğu" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button Content="Temizle" Click="TransferClearCompleted_Click" HorizontalAlignment="Right"
                                                Style="{ThemeResource SubtleButtonStyle}" FontSize="12" />
                                    </Grid>

                                    <!-- Liste veya Boş Durum -->
                                    <ListView x:Name="TransferListView" Grid.Row="1" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="8,8" Margin="0,2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding FileName}" FontWeight="Medium" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding ProgressPercent}" Maximum="100" Margin="0,6" />

                                                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding FormattedSize}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{Binding FormattedSpeed}" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                        <Button Tag="{Binding Id}" Click="TransferCancel_Click" Style="{ThemeResource SubtleButtonStyle}" Padding="4" ToolTipService.ToolTip="İptal">
                                                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                                                        </Button>
                                                        <Button Tag="{Binding Id}" Click="TransferRetry_Click" Style="{ThemeResource SubtleButtonStyle}" Padding="4" ToolTipService.ToolTip="Yeniden Dene">
                                                            <FontIcon Glyph="&#xE72C;" FontSize="10" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <TextBlock x:Name="TransferEmptyText" Grid.Row="1" Text="Aktif veya geçmiş transfer bulunmuyor" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,40" />
                                </Grid>
                            </Flyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarSeparator />
                    <!-- Üç Nokta (...) Menüsü -->
                    <AppBarButton Label="Daha Fazla">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE712;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Yenile" Click="RefreshButton_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Tümünü Seç" Click="SelectAll_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B3;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Ayarlar" Click="OpenSettings_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                </CommandBar>

                <!-- 2: Dosya Gezgini İçerik Alanı ve Önizleme Bölmesi -->
                <Grid Grid.Row="2"
                      AllowDrop="True"
                      DragOver="FileArea_DragOver"
                      Drop="FileArea_Drop">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Sol Taraf: Dosya Görünümleri -->
                    <Grid x:Name="FileAreaGrid" Grid.Column="0" Background="Transparent" 
                          Tapped="FileArea_Tapped"
                          PointerPressed="FileArea_PointerPressed"
                          PointerMoved="FileArea_PointerMoved"
                          PointerReleased="FileArea_PointerReleased"
                          PointerCanceled="FileArea_PointerReleased">
                        <!-- Windows 11 Dosya Gezgini Anında Seçim Çerçevesi (0ms Gecikme) Fırçaları -->
                        <Grid.Resources>
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="#220078D4" />
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="#2E0078D4" />
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="#380078D4" />
                            <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="#10000000" />
                            <SolidColorBrush x:Key="GridViewItemBorderBrushSelected" Color="#660078D4" />
                            <SolidColorBrush x:Key="GridViewItemBorderBrushSelectedPointerOver" Color="#880078D4" />
                            <SolidColorBrush x:Key="GridViewItemBorderBrushSelectedPressed" Color="#AA0078D4" />
                            <SolidColorBrush x:Key="GridViewItemCheckThemeFill" Color="Transparent" />
                            <SolidColorBrush x:Key="GridViewItemCheckThemeFillPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="GridViewItemCheckThemeFillSelected" Color="Transparent" />
                            <Thickness x:Key="GridViewItemBorderThemeThickness">1</Thickness>

                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#220078D4" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#2E0078D4" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#380078D4" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#10000000" />
                            <SolidColorBrush x:Key="ListViewItemBorderBrushSelected" Color="#660078D4" />
                            <SolidColorBrush x:Key="ListViewItemBorderBrushSelectedPointerOver" Color="#880078D4" />
                            <SolidColorBrush x:Key="ListViewItemBorderBrushSelectedPressed" Color="#AA0078D4" />
                            <SolidColorBrush x:Key="ListViewItemCheckThemeFill" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemCheckThemeFillPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemCheckThemeFillSelected" Color="Transparent" />
                            <Thickness x:Key="ListViewItemBorderThemeThickness">1</Thickness>
                        </Grid.Resources>

                        <!-- Yükleniyor Halkası -->
                        <ProgressRing x:Name="LoadingRing" IsActive="False" Width="40" Height="40" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <!-- Fare ile Çerçeve Çizerek Çoklu Seçim (Marquee / Rubber-Band Selection Canvas) -->
                        <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Rectangle x:Name="SelectionBox"
                                       Fill="#330078D4"
                                       Stroke="#0078D4"
                                       StrokeThickness="1"
                                       RadiusX="2" RadiusY="2"
                                       Visibility="Collapsed" />
                        </Canvas>

                        <!-- 1. Grid Görünümü: Büyük Simgeler (Windows 11 Yerel Gezgin Hover & Seçim Stili) -->
                        <GridView x:Name="FileGridView" 
                                  SelectionMode="Extended"
                                  CanDragItems="True"
                                  DragItemsStarting="FileList_DragItemsStarting"
                                  SelectionChanged="FileList_SelectionChanged"
                                  DoubleTapped="FileList_DoubleTapped"
                                  KeyDown="FileList_KeyDown"
                                  RightTapped="FileItem_RightTapped"
                                  AllowDrop="True"
                                  DragOver="FileArea_DragOver"
                                  Drop="FileArea_Drop"
                                  Visibility="Visible">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="CornerRadius" Value="6" />
                                    <Setter Property="Margin" Value="2" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:FileItem">
                                    <Border Background="Transparent"
                                            CornerRadius="6"
                                            Width="120" Height="120"
                                            Padding="8" Margin="0"
                                            Opacity="{x:Bind Opacity, Mode=OneWay}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{x:Bind IconImage}" Width="48" Height="48" Stretch="Uniform"
                                                       Visibility="{x:Bind HasIconImageVisibility}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <FontIcon Glyph="{x:Bind GlyphIcon}" FontSize="40"
                                                          Foreground="{x:Bind IconBrush}"
                                                          Visibility="{x:Bind HasNoIconImageVisibility}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Normal İsim -->
                                            <TextBlock Grid.Row="1" Text="{x:Bind Name}" 
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0"
                                                       Visibility="{x:Bind NormalVisibility, Mode=OneWay}" />

                                            <!-- Yerinde Yeniden Adlandırma Metin Kutusu (Windows 11 Birebir) -->
                                            <TextBox Grid.Row="1" Text="{x:Bind EditingName, Mode=TwoWay}"
                                                     FontSize="11"
                                                     TextAlignment="Center"
                                                     HorizontalAlignment="Stretch"
                                                     Margin="0,2,0,0"
                                                     Padding="3,1,3,1"
                                                     MinHeight="22"
                                                     CornerRadius="3"
                                                     BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                     BorderThickness="1"
                                                     Visibility="{x:Bind EditingVisibility, Mode=OneWay}"
                                                     Loaded="InlineRenameTextBox_Loaded"
                                                     KeyDown="InlineRenameTextBox_KeyDown"
                                                     LostFocus="InlineRenameTextBox_LostFocus"
                                                     BeforeTextChanging="InlineRenameTextBox_BeforeTextChanging" />

                                            <TextBlock Grid.Row="2" Text="{x:Bind FormattedSize}" 
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <!-- 2. Grid Görünümü: Orta Simgeler (96x96, Yerel Hover) -->
                        <GridView x:Name="FileGridViewMedium" 
                                  SelectionMode="Extended"
                                  CanDragItems="True"
                                  DragItemsStarting="FileList_DragItemsStarting"
                                  SelectionChanged="FileList_SelectionChanged"
                                  DoubleTapped="FileList_DoubleTapped"
                                  KeyDown="FileList_KeyDown"
                                  RightTapped="FileItem_RightTapped"
                                  AllowDrop="True"
                                  DragOver="FileArea_DragOver"
                                  Drop="FileArea_Drop"
                                  Visibility="Collapsed">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="CornerRadius" Value="6" />
                                    <Setter Property="Margin" Value="2" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:FileItem">
                                    <Border Background="Transparent"
                                            CornerRadius="6"
                                            Width="92" Height="92"
                                            Padding="6" Margin="0"
                                            Opacity="{x:Bind Opacity, Mode=OneWay}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{x:Bind IconImage}" Width="36" Height="36" Stretch="Uniform"
                                                       Visibility="{x:Bind HasIconImageVisibility}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <FontIcon Glyph="{x:Bind GlyphIcon}" FontSize="30"
                                                          Foreground="{x:Bind IconBrush}"
                                                          Visibility="{x:Bind HasNoIconImageVisibility}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Normal İsim -->
                                            <TextBlock Grid.Row="1" Text="{x:Bind Name}" 
                                                       FontWeight="Normal"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,0"
                                                       Visibility="{x:Bind NormalVisibility, Mode=OneWay}" />

                                            <!-- Yerinde Yeniden Adlandırma (Windows 11 Birebir) -->
                                            <TextBox Grid.Row="1" Text="{x:Bind EditingName, Mode=TwoWay}"
                                                     FontSize="11"
                                                     TextAlignment="Center"
                                                     HorizontalAlignment="Stretch"
                                                     Margin="0,2,0,0"
                                                     Padding="3,1,3,1"
                                                     MinHeight="22"
                                                     CornerRadius="3"
                                                     BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                     BorderThickness="1"
                                                     Visibility="{x:Bind EditingVisibility, Mode=OneWay}"
                                                     Loaded="InlineRenameTextBox_Loaded"
                                                     KeyDown="InlineRenameTextBox_KeyDown"
                                                     LostFocus="InlineRenameTextBox_LostFocus"
                                                     BeforeTextChanging="InlineRenameTextBox_BeforeTextChanging" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <!-- 3. Liste / Tablo Görünümü (Ayrıntılar - Yerel Dosya Gezgini Satır Hover Stili) -->
                        <ListView x:Name="FileListView"
                                  SelectionMode="Extended"
                                  CanDragItems="True"
                                  DragItemsStarting="FileList_DragItemsStarting"
                                  SelectionChanged="FileList_SelectionChanged"
                                  DoubleTapped="FileList_DoubleTapped"
                                  KeyDown="FileList_KeyDown"
                                  RightTapped="FileItem_RightTapped"
                                  AllowDrop="True"
                                  DragOver="FileArea_DragOver"
                                  Drop="FileArea_Drop"
                                  Visibility="Collapsed">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="CornerRadius" Value="4" />
                                    <Setter Property="Margin" Value="4,1,4,1" />
                                    <Setter Property="MinHeight" Value="32" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.Header>
                                <Grid Padding="8,4,8,4" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                                      RightTapped="Header_RightTapped">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" x:Name="ColHeaderName" MinWidth="140" />
                                        <ColumnDefinition Width="6" x:Name="ColSplitterDateCol" />
                                        <ColumnDefinition Width="180" x:Name="ColHeaderDate" MinWidth="0" />
                                        <ColumnDefinition Width="6" x:Name="ColSplitterTypeCol" />
                                        <ColumnDefinition Width="140" x:Name="ColHeaderType" MinWidth="0" />
                                        <ColumnDefinition Width="6" x:Name="ColSplitterSizeCol" />
                                        <ColumnDefinition Width="100" x:Name="ColHeaderSize" MinWidth="0" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <Button Grid.Column="0" Click="HeaderSortByName_Click" Style="{ThemeResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Ad" FontWeight="SemiBold" FontSize="12" />
                                            <FontIcon x:Name="SortNameArrow" Glyph="&#xE70E;" FontSize="10" Visibility="Visible" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Splitter Date -->
                                    <Border Grid.Column="1" x:Name="BorderSplitterDate" Width="6" HorizontalAlignment="Stretch" Background="Transparent"
                                            Tag="Date"
                                            PointerEntered="Splitter_PointerEntered"
                                            PointerExited="Splitter_PointerExited"
                                            PointerPressed="Splitter_PointerPressed"
                                            PointerMoved="Splitter_PointerMoved"
                                            PointerReleased="Splitter_PointerReleased"
                                            DoubleTapped="Splitter_DoubleTapped">
                                        <Rectangle Width="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
                                    </Border>

                                    <Button Grid.Column="2" x:Name="BtnHeaderDate" Click="HeaderSortByDate_Click" Style="{ThemeResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Değiştirilme Tarihi" FontWeight="SemiBold" FontSize="12" />
                                            <FontIcon x:Name="SortDateArrow" Glyph="&#xE70E;" FontSize="10" Visibility="Collapsed" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Splitter Type -->
                                    <Border Grid.Column="3" x:Name="BorderSplitterType" Width="6" HorizontalAlignment="Stretch" Background="Transparent"
                                            Tag="Type"
                                            PointerEntered="Splitter_PointerEntered"
                                            PointerExited="Splitter_PointerExited"
                                            PointerPressed="Splitter_PointerPressed"
                                            PointerMoved="Splitter_PointerMoved"
                                            PointerReleased="Splitter_PointerReleased"
                                            DoubleTapped="Splitter_DoubleTapped">
                                        <Rectangle Width="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
                                    </Border>

                                    <Button Grid.Column="4" x:Name="BtnHeaderType" Click="HeaderSortByType_Click" Style="{ThemeResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Tür" FontWeight="SemiBold" FontSize="12" />
                                            <FontIcon x:Name="SortTypeArrow" Glyph="&#xE70E;" FontSize="10" Visibility="Collapsed" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Splitter Size -->
                                    <Border Grid.Column="5" x:Name="BorderSplitterSize" Width="6" HorizontalAlignment="Stretch" Background="Transparent"
                                            Tag="Size"
                                            PointerEntered="Splitter_PointerEntered"
                                            PointerExited="Splitter_PointerExited"
                                            PointerPressed="Splitter_PointerPressed"
                                            PointerMoved="Splitter_PointerMoved"
                                            PointerReleased="Splitter_PointerReleased"
                                            DoubleTapped="Splitter_DoubleTapped">
                                        <Rectangle Width="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
                                    </Border>

                                    <Button Grid.Column="6" x:Name="BtnHeaderSize" Click="HeaderSortBySize_Click" Style="{ThemeResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Padding="8,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Boyut" FontWeight="SemiBold" FontSize="12" />
                                            <FontIcon x:Name="SortSizeArrow" Glyph="&#xE70E;" FontSize="10" Visibility="Collapsed" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:FileItem">
                                    <Grid Padding="8,4,8,4"
                                          Background="Transparent"
                                          Opacity="{x:Bind Opacity, Mode=OneWay}"
                                          MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="{x:Bind ColDateSplitterWidth, Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind ColDateWidth, Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind ColTypeSplitterWidth, Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind ColTypeWidth, Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind ColSizeSplitterWidth, Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind ColSizeWidth, Mode=OneWay}" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Margin="8,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- İkon -->
                                            <Grid Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Image Source="{x:Bind IconImageSmall}" Width="16" Height="16" Stretch="Uniform"
                                                       Visibility="{x:Bind HasIconImageVisibility}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <FontIcon Glyph="{x:Bind GlyphIcon}" FontSize="16" 
                                                          Foreground="{x:Bind IconBrush}"
                                                          Visibility="{x:Bind HasNoIconImageVisibility}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Normal İsim -->
                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" 
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="8,0,0,0"
                                                       Visibility="{x:Bind NormalVisibility, Mode=OneWay}" />

                                            <!-- Yerinde Yeniden Adlandırma (Windows 11 Birebir) -->
                                            <TextBox Grid.Column="1" Text="{x:Bind EditingName, Mode=TwoWay}"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Left"
                                                     MinWidth="140"
                                                     MaxWidth="350"
                                                     Margin="6,0,0,0"
                                                     FontSize="12"
                                                     Padding="4,1,4,1"
                                                     MinHeight="22"
                                                     Height="26"
                                                     CornerRadius="3"
                                                     BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                     BorderThickness="1"
                                                     Visibility="{x:Bind EditingVisibility, Mode=OneWay}"
                                                     Loaded="InlineRenameTextBox_Loaded"
                                                     KeyDown="InlineRenameTextBox_KeyDown"
                                                     LostFocus="InlineRenameTextBox_LostFocus"
                                                     BeforeTextChanging="InlineRenameTextBox_BeforeTextChanging" />
                                        </Grid>

                                        <TextBlock Grid.Column="2" Text="{x:Bind FormattedDate}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                                                   Visibility="{x:Bind ColDateVisibility, Mode=OneWay}" />
                                        
                                        <TextBlock Grid.Column="4" Text="{x:Bind TypeDescription}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Visibility="{x:Bind ColTypeVisibility, Mode=OneWay}" />
                                        
                                        <TextBlock Grid.Column="6" Text="{x:Bind FormattedSize}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                                                   Visibility="{x:Bind ColSizeVisibility, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Sağ Taraf: Windows 11 Ayrıntılar ve Önizleme Bölmesi (Details / Preview Pane) -->
                    <Border x:Name="PreviewPane" Grid.Column="1"
                            Width="280" Margin="0"
                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1,0,0,0"
                            CornerRadius="0"
                            Padding="16,16,16,16"
                            Visibility="Collapsed">
                        <Grid>
                            <!-- 1. Boş Durum (Öğe Seçilmediğinde - Windows 11 Birebir) -->
                            <StackPanel x:Name="PreviewEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                                <FontIcon Glyph="&#xE8A5;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Öğe seçilmedi" 
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                           FontSize="13" 
                                           TextAlignment="Center" />
                                <TextBlock Text="Ayrıntıları görüntülemek için bir dosya seçin." 
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                           FontSize="11" 
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- 2. Dolu Durum (Öğe Seçildiğinde - Windows 11 Birebir) -->
                            <ScrollViewer x:Name="PreviewContentState" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <StackPanel Spacing="14">
                                    <!-- Büyük İkon / Resim / Belge Önizlemesi (Windows 11 Birebir) -->
                                    <Grid Height="180" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <!-- İkon Görünümü -->
                                        <StackPanel x:Name="PreviewIconContainer" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                            <Image x:Name="PreviewIconImage" Width="80" Height="80" Stretch="Uniform" Visibility="Collapsed" />
                                            <FontIcon x:Name="PreviewIcon" Glyph="&#xE8A5;" FontSize="80" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                        
                                        <!-- Resim Önizlemesi -->
                                        <Border CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image x:Name="PreviewImage" Stretch="Uniform" MaxHeight="175" Visibility="Collapsed" />
                                        </Border>

                                        <!-- Metin / Kod Dosyası Canlı Önizlemesi -->
                                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
                                            <ScrollViewer x:Name="PreviewTextScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Visibility="Collapsed">
                                                <TextBlock x:Name="PreviewTextContent" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>

                                    <!-- Dosya Adı ve Tür Başlığı (Windows 11 Standartları) -->
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="PreviewFileName" Text="Dosya Adı" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                                        <TextBlock x:Name="PreviewTypeBadge" Text="Dosya Türü" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" />
                                    </StackPanel>

                                    <MenuFlyoutSeparator Margin="0,4,0,4" />

                                    <!-- Windows 11 Standart Özellikler Tablosu (Ayrıntılar) -->
                                    <Grid RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Öğe türü:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        <TextBlock x:Name="PreviewExtensionText" Grid.Row="0" Grid.Column="1" Text="--" FontSize="12" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Boyut:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        <TextBlock x:Name="PreviewSizeText" Grid.Row="1" Grid.Column="1" Text="--" FontWeight="Medium" FontSize="12" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Değiştirilme:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        <TextBlock x:Name="PreviewDateText" Grid.Row="2" Grid.Column="1" Text="--" FontSize="12" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Klasör:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        <TextBlock x:Name="PreviewPathText" Grid.Row="3" Grid.Column="1" Text="--" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>

                                    <!-- Windows 11 Aç / İndir Eylem Butonları -->
                                    <StackPanel Spacing="8" Margin="0,8,0,0">
                                        <Button x:Name="PreviewOpenButton" Content="Dosyayı Aç" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="PreviewOpenButton_Click" />
                                        <Button x:Name="PreviewDownloadButton" Content="İndir ve Kaydet..." HorizontalAlignment="Stretch" Click="PreviewDownloadButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Sağ Tık Menüsü (Yerel Dosya Gezgini Stili) -->
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Aç (Enter)" Click="ContextOpen_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8E5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="ContextPinItem" Text="Kenar Çubuğuna Sabitle" Click="ContextPin_Click" Visibility="Collapsed">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon x:Name="ContextPinIcon" Glyph="&#xE718;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="İndir ve Kaydet" Click="ContextDownload_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE896;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Yeniden Adlandır (F2)" Click="ContextRename_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8AC;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Kes (Ctrl+X)" Click="ContextCut_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C6;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Kopyala (Ctrl+C)" Click="ContextCopy_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Yapıştır (Ctrl+V)" Click="ContextPaste_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE77F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Sil (Delete)" Click="ContextDelete_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" Foreground="#E81123" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Özellikler (Alt+Enter)" Click="ContextProperties_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE946;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Grid.ContextFlyout>
                </Grid>
            </Grid>
        </NavigationView>

        <!-- 2: Windows Durum Çubuğu -->
        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Padding="16,0,16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ItemCountText" Grid.Column="0" Text="0 öğe" 
                           VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBlock x:Name="StatusConnectionText" Grid.Column="1" Text="Bulut Bağlantısı Aktif" 
                           VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
