<Window
    x:Class="HDriveWin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:HDriveWin.Models"
    mc:Ignorable="d"
    Title="HDrive">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Özel Başlık Çubuğu (TitleBar) -->
            <RowDefinition Height="48" />
            <!-- 1: Ana İçerik ve Gezinti Çubuğu -->
            <RowDefinition Height="*" />
            <!-- 2: Durum Çubuğu -->
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 0: Windows 11 Başlık Çubuğu (Sürükleme Alanı & Temiz) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" VerticalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="10">
                <FontIcon Glyph="&#xE753;" FontSize="16" Foreground="{ThemeResource HDriveAccentBrush}" />
                <TextBlock Text="HDrive - Dosya Gezgini" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 1: NavigationView (Windows 11 Sol Kenar Çubuğu ve İçerik) -->
        <NavigationView x:Name="NavView" Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        ItemInvoked="NavView_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="CloudreveNavItem" Content="Cloudreve" Tag="cloud">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE753;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LocalFolderNavItem" Content="Yerel Eşitleme Klasörü" Tag="local">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xED43;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Gezinti Çubuğu İçeriği -->
            <Grid Margin="16,0,16,16">
                <Grid.RowDefinitions>
                    <!-- 0: Komut Çubuğu (CommandBar / Şerit) -->
                    <RowDefinition Height="Auto" />
                    <!-- 1: Windows 11 Adres & Arama Çubuğu Satırı -->
                    <RowDefinition Height="Auto" />
                    <!-- 2: Dosya Listesi -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 0: Komut Çubuğu (Yeni, Yükle, Yenile, Görünüm) -->
                <CommandBar Grid.Row="0" Background="Transparent" DefaultLabelPosition="Right" Margin="0,0,0,8" HorizontalAlignment="Left">
                    <AppBarButton Icon="NewFolder" Label="Yeni Klasör" Click="NewFolderButton_Click" />
                    <AppBarButton Icon="Upload" Label="Yükle" Click="UploadButton_Click" />
                    <AppBarButton Icon="Refresh" Label="Yenile" Click="RefreshButton_Click" />
                    <AppBarSeparator />
                    <AppBarButton x:Name="ViewToggleButton" Icon="View" Label="Görünüm" Click="ViewToggleButton_Click" />
                </CommandBar>

                <!-- 1: Windows 11 Adres Çubuğu & Arama Satırı -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <!-- Geri / İleri / Yukarı Butonları -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Adres / Breadcrumb Bar (Esneyen) -->
                        <ColumnDefinition Width="*" />
                        <!-- Arama Kutusu -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Windows Tarzı Gezinti Butonları (< > ^) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0">
                        <Button x:Name="BackButton" Click="BackButton_Click" IsEnabled="False" 
                                ToolTipService.ToolTip="Geri (Alt + Sol Ok)" Padding="8,6" CornerRadius="4">
                            <FontIcon Glyph="&#xE72B;" FontSize="12" />
                        </Button>
                        <Button x:Name="ForwardButton" Click="ForwardButton_Click" IsEnabled="False" 
                                ToolTipService.ToolTip="İleri (Alt + Sağ Ok)" Padding="8,6" CornerRadius="4">
                            <FontIcon Glyph="&#xE72A;" FontSize="12" />
                        </Button>
                        <Button x:Name="UpButton" Click="UpButton_Click" IsEnabled="False" 
                                ToolTipService.ToolTip="Üst Klasör (Alt + Yukarı Ok)" Padding="8,6" CornerRadius="4">
                            <FontIcon Glyph="&#xE74A;" FontSize="12" />
                        </Button>
                    </StackPanel>

                    <!-- Adres Çubuğu Kutusu (Windows 11 File Explorer Tarzı) -->
                    <Border Grid.Column="1" 
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,2,8,2"
                            VerticalAlignment="Center"
                            Height="36">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE753;" FontSize="14" 
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" 
                                      Margin="0,0,6,0" VerticalAlignment="Center" />
                            <BreadcrumbBar x:Name="PathBreadcrumbBar" Grid.Column="1" 
                                           ItemClicked="PathBreadcrumbBar_ItemClicked"
                                           VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Windows 11 Arama Çubuğu -->
                    <AutoSuggestBox x:Name="SearchBox" Grid.Column="2" 
                                    Width="260" Margin="8,0,0,0"
                                    Height="36"
                                    PlaceholderText="Cloudreve içinde ara..."
                                    QueryIcon="Find"
                                    VerticalAlignment="Center"
                                    CornerRadius="4"
                                    TextChanged="SearchBox_TextChanged" />
                </Grid>

                <!-- 2: Dosya Gezgini İçerik Alanı (Sürükle-Bırak Destekli) -->
                <Grid Grid.Row="2"
                      AllowDrop="True"
                      DragOver="FileArea_DragOver"
                      Drop="FileArea_Drop">
                    <!-- Yükleniyor Halkası -->
                    <ProgressRing x:Name="LoadingRing" IsActive="False" Width="40" Height="40" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <!-- 1. Grid Görünümü (Büyük Simgeler, Dışarı Sürükleme ve Yükleme Destekli) -->
                    <GridView x:Name="FileGridView" 
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="FileItem_Clicked"
                              RightTapped="FileItem_RightTapped"
                              AllowDrop="True"
                              DragOver="FileArea_DragOver"
                              Drop="FileArea_Drop"
                              Visibility="Visible">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:FileItem">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Width="130" Height="130"
                                        Padding="10" Margin="4"
                                        CanDrag="True"
                                        DragStarting="FileItem_DragStarting">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <FontIcon Grid.Row="0" Glyph="{x:Bind GlyphIcon}" FontSize="40"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="1" Text="{x:Bind Name}" 
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="2"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0" />

                                        <TextBlock Grid.Row="2" Text="{x:Bind FormattedSize}" 
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- 2. Liste / Tablo Görünümü (Ayrıntılar, Dışarı Sürükleme ve Yükleme Destekli) -->
                    <ListView x:Name="FileListView"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="FileItem_Clicked"
                              RightTapped="FileItem_RightTapped"
                              AllowDrop="True"
                              DragOver="FileArea_DragOver"
                              Drop="FileArea_Drop"
                              Visibility="Collapsed">
                        <ListView.Header>
                            <Grid Padding="12,6,12,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ad" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Değiştirilme Tarihi" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Tür" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="Boyut" FontWeight="SemiBold" TextAlignment="Right" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FileItem">
                                <Grid Padding="6,8,6,8"
                                      CanDrag="True"
                                      DragStarting="FileItem_DragStarting">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="{x:Bind GlyphIcon}" FontSize="16" 
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" 
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{x:Bind FormattedDate}" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    
                                    <TextBlock Grid.Column="2" Text="{x:Bind TypeDescription}" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    
                                    <TextBlock Grid.Column="3" Text="{x:Bind FormattedSize}" VerticalAlignment="Center"
                                               TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Sağ Tık Menüsü (Flyout) -->
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Aç" Click="ContextOpen_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8E5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="İndir" Click="ContextDownload_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE896;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Sil" Click="ContextDelete_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Grid.ContextFlyout>
                </Grid>
            </Grid>
        </NavigationView>

        <!-- 2: Windows Durum Çubuğu -->
        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Padding="16,0,16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ItemCountText" Grid.Column="0" Text="0 öğe" 
                           VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBlock x:Name="SyncStatusText" Grid.Column="1" Text="Eşitleme: Hazır" 
                           VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
