<Window
    x:Class="HDriveWin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:HDriveWin.Models"
    mc:Ignorable="d"
    Title="HDrive">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Özel Başlık Çubuğu (TitleBar) -->
            <RowDefinition Height="40" />
            <!-- 1: Ana İçerik ve Gezinti Çubuğu -->
            <RowDefinition Height="*" />
            <!-- 2: Durum Çubuğu -->
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- 0: Windows 11 Başlık Çubuğu & Sekmeler (TabView - Sıfır Üst Boşluk, Birebir Windows 11 Hizalaması) -->
        <Grid Grid.Row="0" VerticalAlignment="Stretch" Height="40">
            <!-- Windows 11 Sekmeler (Sol kenardan 8px) -->
            <TabView x:Name="ExplorerTabs"
                     Margin="8,0,0,0"
                     VerticalAlignment="Stretch"
                     IsAddTabButtonVisible="True"
                     CanDragTabs="True"
                     CanReorderTabs="True"
                     AddTabButtonClick="ExplorerTabs_AddTabButtonClick"
                     TabCloseRequested="ExplorerTabs_TabCloseRequested"
                     SelectionChanged="ExplorerTabs_SelectionChanged">
                <TabView.TabStripFooter>
                    <!-- Drag Region: Sekmelerden sonraki boş alan pencereyi sürüklemek için kullanılır. MinWidth 188px sistem butonlarını korur -->
                    <Grid x:Name="CustomDragRegion" Background="Transparent" MinWidth="188" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </TabView.TabStripFooter>
            </TabView>
        </Grid>

        <!-- 1: NavigationView (Windows 11 Sol Kenar Çubuğu ve İçerik) -->
        <NavigationView x:Name="NavView" Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        ItemInvoked="NavView_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="CloudreveNavItem" Content="Cloudreve" Tag="cloud">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE753;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LocalFolderNavItem" Content="Yerel Eşitleme Klasörü" Tag="local">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xED43;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Gezinti Çubuğu İçeriği -->
            <Grid Margin="12,0,12,12">
                <Grid.RowDefinitions>
                    <!-- 0: Windows 11 Adres & Arama Çubuğu Satırı -->
                    <RowDefinition Height="Auto" />
                    <!-- 1: Komut Çubuğu (CommandBar / Şerit) -->
                    <RowDefinition Height="Auto" />
                    <!-- 2: Dosya Listesi -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 0: Windows 11 Adres Çubuğu & Arama Satırı (Tam Klasör Tasarımı) -->
                <Grid Grid.Row="0" Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <!-- Geri / İleri / Yukarı / Yenile Butonları -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Adres / Breadcrumb Bar (Esneyen) -->
                        <ColumnDefinition Width="*" />
                        <!-- Arama Kutusu -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Windows 11 Tarzı Gezinti Butonları (< > ^ ↻) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Button x:Name="BackButton" Click="BackButton_Click" IsEnabled="False" 
                                ToolTipService.ToolTip="Geri (Alt + Sol Ok)" Width="32" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <FontIcon Glyph="&#xE72B;" FontSize="12" />
                        </Button>
                        <Button x:Name="ForwardButton" Click="ForwardButton_Click" IsEnabled="False" 
                                ToolTipService.ToolTip="İleri (Alt + Sağ Ok)" Width="32" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <FontIcon Glyph="&#xE72A;" FontSize="12" />
                        </Button>
                        <Button x:Name="UpButton" Click="UpButton_Click" IsEnabled="False" 
                                ToolTipService.ToolTip="Üst Klasör (Alt + Yukarı Ok)" Width="32" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <FontIcon Glyph="&#xE74A;" FontSize="12" />
                        </Button>
                        <Button x:Name="NavRefreshButton" Click="RefreshButton_Click"
                                ToolTipService.ToolTip="Yenile (F5)" Width="32" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        </Button>
                    </StackPanel>

                    <!-- Adres Çubuğu Kutusu (Windows 11 File Explorer Birebir Tasarım) -->
                    <Border Grid.Column="1" 
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,0,8,0"
                            VerticalAlignment="Center"
                            Height="32">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="13" 
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" 
                                      Margin="0,0,6,0" VerticalAlignment="Center" />
                            <BreadcrumbBar x:Name="PathBreadcrumbBar" Grid.Column="1" 
                                           ItemClicked="PathBreadcrumbBar_ItemClicked"
                                           VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Windows 11 Arama Çubuğu -->
                    <AutoSuggestBox x:Name="SearchBox" Grid.Column="2" 
                                    Width="240" Margin="6,0,0,0"
                                    Height="32"
                                    PlaceholderText="HDrive içinde ara"
                                    QueryIcon="Find"
                                    VerticalAlignment="Center"
                                    CornerRadius="4"
                                    TextChanged="SearchBox_TextChanged" />
                </Grid>

                <!-- 1: Komut Çubuğu (Windows 11 Komut Şeridi & Üç Nokta Menüsü) -->
                <CommandBar Grid.Row="1" Background="Transparent" DefaultLabelPosition="Right" Margin="0,0,0,4" HorizontalAlignment="Left">
                    <AppBarButton Icon="NewFolder" Label="Yeni Klasör" Click="NewFolderButton_Click" />
                    <AppBarButton Icon="Upload" Label="Yükle" Click="UploadButton_Click" />
                    <AppBarSeparator />
                    <AppBarButton Icon="View" Label="Görünüm">
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Büyük Simgeler" Click="ViewLarge_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE80A;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Orta Simgeler" Click="ViewMedium_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7F4;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Ayrıntılar" Click="ViewDetails_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C0;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarToggleButton x:Name="PreviewPaneToggle" Icon="PreviewLink" Label="Önizleme" Click="PreviewPaneToggle_Click" />
                    <AppBarSeparator />
                    <!-- Üç Nokta (...) Menüsü -->
                    <AppBarButton Label="Daha Fazla">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE712;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Yenile" Click="RefreshButton_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Şimdi Eşitle" Click="SyncNow_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE895;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Yerel Klasörü Aç" Click="OpenLocalFolder_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED43;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Tümünü Seç" Click="SelectAll_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B3;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Ayarlar" Click="OpenSettings_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                </CommandBar>

                <!-- 2: Dosya Gezgini İçerik Alanı ve Önizleme Bölmesi -->
                <Grid Grid.Row="2"
                      AllowDrop="True"
                      DragOver="FileArea_DragOver"
                      Drop="FileArea_Drop">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Sol Taraf: Dosya Görünümleri -->
                    <Grid Grid.Column="0">
                        <!-- Yükleniyor Halkası -->
                        <ProgressRing x:Name="LoadingRing" IsActive="False" Width="40" Height="40" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <!-- 1. Grid Görünümü: Büyük Simgeler (130x130, Orijinal Windows 11 Renkleri) -->
                        <GridView x:Name="FileGridView" 
                                  SelectionMode="Single"
                                  SelectionChanged="FileList_SelectionChanged"
                                  DoubleTapped="FileList_DoubleTapped"
                                  KeyDown="FileList_KeyDown"
                                  RightTapped="FileItem_RightTapped"
                                  AllowDrop="True"
                                  DragOver="FileArea_DragOver"
                                  Drop="FileArea_Drop"
                                  Visibility="Visible">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:FileItem">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Width="130" Height="130"
                                            Padding="10" Margin="4"
                                            Tapped="Item_Tapped"
                                            DoubleTapped="Item_DoubleTapped"
                                            CanDrag="True"
                                            DragStarting="FileItem_DragStarting">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <FontIcon Grid.Row="0" Glyph="{x:Bind GlyphIcon}" FontSize="44"
                                                      Foreground="{x:Bind IconBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="1" Text="{x:Bind Name}" 
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0" />

                                            <TextBlock Grid.Row="2" Text="{x:Bind FormattedSize}" 
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <!-- 2. Grid Görünümü: Orta Simgeler (96x96) -->
                        <GridView x:Name="FileGridViewMedium" 
                                  SelectionMode="Single"
                                  SelectionChanged="FileList_SelectionChanged"
                                  DoubleTapped="FileList_DoubleTapped"
                                  KeyDown="FileList_KeyDown"
                                  RightTapped="FileItem_RightTapped"
                                  AllowDrop="True"
                                  DragOver="FileArea_DragOver"
                                  Drop="FileArea_Drop"
                                  Visibility="Collapsed">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:FileItem">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Width="96" Height="96"
                                            Padding="6" Margin="3"
                                            Tapped="Item_Tapped"
                                            DoubleTapped="Item_DoubleTapped"
                                            CanDrag="True"
                                            DragStarting="FileItem_DragStarting">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <FontIcon Grid.Row="0" Glyph="{x:Bind GlyphIcon}" FontSize="32"
                                                      Foreground="{x:Bind IconBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="1" Text="{x:Bind Name}" 
                                                       FontWeight="Normal"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <!-- 3. Liste / Tablo Görünümü (Ayrıntılar) -->
                        <ListView x:Name="FileListView"
                                  SelectionMode="Single"
                                  SelectionChanged="FileList_SelectionChanged"
                                  DoubleTapped="FileList_DoubleTapped"
                                  KeyDown="FileList_KeyDown"
                                  RightTapped="FileItem_RightTapped"
                                  AllowDrop="True"
                                  DragOver="FileArea_DragOver"
                                  Drop="FileArea_Drop"
                                  Visibility="Collapsed">
                            <ListView.Header>
                                <Grid Padding="12,6,12,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ad" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Değiştirilme Tarihi" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Tür" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Boyut" FontWeight="SemiBold" TextAlignment="Right" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:FileItem">
                                    <Grid Padding="6,8,6,8"
                                          Tapped="Item_Tapped"
                                          DoubleTapped="Item_DoubleTapped"
                                          CanDrag="True"
                                          DragStarting="FileItem_DragStarting">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="{x:Bind GlyphIcon}" FontSize="16" 
                                                      Foreground="{x:Bind IconBrush}" />
                                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" 
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{x:Bind FormattedDate}" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        
                                        <TextBlock Grid.Column="2" Text="{x:Bind TypeDescription}" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        
                                        <TextBlock Grid.Column="3" Text="{x:Bind FormattedSize}" VerticalAlignment="Center"
                                                   TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Sağ Taraf: Windows 11 Önizleme Bölmesi (Preview Pane - PDF, Resim, Belge) -->
                    <Border x:Name="PreviewPane" Grid.Column="1"
                            Width="300" Margin="12,0,0,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <!-- Başlık & Kapat Butonu -->
                                <Grid>
                                    <TextBlock Text="Önizleme Bölmesi" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                    <Button HorizontalAlignment="Right" Click="ClosePreviewPane_Click" Padding="6,4" CornerRadius="4" ToolTipService.ToolTip="Önizlemeyi Kapat">
                                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                                    </Button>
                                </Grid>

                                <!-- Önizleme Görsel Kartı -->
                                <Border Height="180" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon x:Name="PreviewIcon" Glyph="&#xE8A5;" FontSize="72" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <Image x:Name="PreviewImage" Stretch="Uniform" MaxHeight="170" Visibility="Collapsed" />
                                    </Grid>
                                </Border>

                                <!-- Dosya Başlığı ve Tür Etiketi -->
                                <TextBlock x:Name="PreviewFileName" Text="Dosya Seçilmedi" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                                <Border x:Name="PreviewBadge" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center">
                                    <TextBlock x:Name="PreviewTypeBadge" Text="Bilinmeyen" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                </Border>

                                <MenuFlyoutSeparator Margin="0,2,0,2" />

                                <!-- Ayrıntılı Bilgi Alanı -->
                                <Grid RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Boyut:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    <TextBlock x:Name="PreviewSizeText" Grid.Row="0" Grid.Column="1" Text="--" FontWeight="SemiBold" FontSize="12" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Değiştirilme:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    <TextBlock x:Name="PreviewDateText" Grid.Row="1" Grid.Column="1" Text="--" FontSize="12" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Biçim:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    <TextBlock x:Name="PreviewExtensionText" Grid.Row="2" Grid.Column="1" Text="--" FontSize="12" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Konum:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    <TextBlock x:Name="PreviewPathText" Grid.Row="3" Grid.Column="1" Text="--" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>

                                <!-- Hızlı Eylemler -->
                                <StackPanel Spacing="8" Margin="0,8,0,0">
                                    <Button x:Name="PreviewOpenButton" Content="Varsayılan Uygulamayla Aç" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="PreviewOpenButton_Click" />
                                    <Button x:Name="PreviewDownloadButton" Content="İndir ve Kaydet" HorizontalAlignment="Stretch" Click="PreviewDownloadButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Sağ Tık Menüsü (Flyout) -->
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Aç" Click="ContextOpen_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8E5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="İndir" Click="ContextDownload_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE896;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Sil" Click="ContextDelete_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Grid.ContextFlyout>
                </Grid>
            </Grid>
        </NavigationView>

        <!-- 2: Windows Durum Çubuğu -->
        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Padding="16,0,16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ItemCountText" Grid.Column="0" Text="0 öğe" 
                           VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBlock x:Name="SyncStatusText" Grid.Column="1" Text="Eşitleme: Hazır" 
                           VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
