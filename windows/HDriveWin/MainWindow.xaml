<Window
    x:Class="HDriveWin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:HDriveWin.Models"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d"
    Title="HDrive">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Özel Başlık Çubuğu (TitleBar) -->
            <RowDefinition Height="40" />
            <!-- 1: Ana İçerik ve Gezinti Çubuğu -->
            <RowDefinition Height="*" />
            <!-- 2: Durum Çubuğu -->
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- 0: Windows 11 Başlık Çubuğu & Sekmeler (TabView - Birebir Windows 11 Dosya Gezgini Sekme Şekli & Animasyonu) -->
        <Grid Grid.Row="0" VerticalAlignment="Stretch" Height="40">
            <!-- Windows 11 Sekmeler (Sol kenardan 8px, eşit genişlik animasyonu, hover kapat butonu) -->
            <TabView x:Name="ExplorerTabs"
                     Margin="8,0,0,0"
                     VerticalAlignment="Stretch"
                     TabWidthMode="Equal"
                     CloseButtonOverlayMode="OnPointerOver"
                     IsAddTabButtonVisible="True"
                     CanDragTabs="True"
                     CanReorderTabs="True"
                     AddTabButtonClick="ExplorerTabs_AddTabButtonClick"
                     TabCloseRequested="ExplorerTabs_TabCloseRequested"
                     SelectionChanged="ExplorerTabs_SelectionChanged">
                <TabView.Resources>
                    <!-- Windows 11 Dosya Gezgini Sekme Ölçüleri ve Köşe Yuvarlaklığı -->
                    <x:Double x:Key="TabViewItemHeaderMinHeight">34</x:Double>
                    <x:Double x:Key="TabViewItemHeaderMinWidth">130</x:Double>
                    <x:Double x:Key="TabViewItemHeaderMaxWidth">240</x:Double>
                    <CornerRadius x:Key="TabViewItemCornerRadius">7,7,0,0</CornerRadius>
                    <CornerRadius x:Key="OverlayCornerRadius">7,7,0,0</CornerRadius>
                </TabView.Resources>
                <TabView.TabStripFooter>
                    <!-- Drag Region: Sekmelerden sonraki boş alan pencereyi sürüklemek için kullanılır. MinWidth 188px sistem butonlarını korur -->
                    <Grid x:Name="CustomDragRegion" Background="Transparent" MinWidth="188" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </TabView.TabStripFooter>
            </TabView>
        </Grid>

        <!-- 1: NavigationView (Windows 11 Sol Kenar Çubuğu ve İçerik) -->
        <NavigationView x:Name="NavView" Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        AllowDrop="True"
                        DragOver="NavView_DragOver"
                        Drop="NavView_Drop"
                        ItemInvoked="NavView_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="AllFilesNavItem" Content="Tüm Dosyalar" Tag="cloud">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE753;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader x:Name="FavoritesHeader" Content="Favoriler" />
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <!-- Sabit Alt Depolama Alanı (Sticky Quota Footer) -->
                <Border Padding="14,10,14,12" 
                        BorderThickness="0,1,0,0" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEDA2;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Depolama" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="StorageQuotaPercentText" Text="%0" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <ProgressBar x:Name="StorageQuotaProgressBar" Value="0" Maximum="100" Height="4" CornerRadius="2" />

                        <Grid>
                            <TextBlock x:Name="StorageQuotaDetailText" Text="-- / --" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <Button x:Name="RefreshQuotaButton" Click="RefreshQuotaButton_Click" ToolTipService.ToolTip="Depolama bilgisini yenile"
                                    HorizontalAlignment="Right" Padding="4,2" Background="Transparent" BorderThickness="0" CornerRadius="4">
                                <FontIcon Glyph="&#xE72C;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>

            <!-- Gezinti Çubuğu İçeriği -->
            <Grid Margin="12,0,12,12">
                <Grid.RowDefinitions>
                    <!-- 0: Windows 11 Adres & Arama Çubuğu Satırı -->
                    <RowDefinition Height="Auto" />
                    <!-- 1: Komut Çubuğu (CommandBar / Şerit) -->
                    <RowDefinition Height="Auto" />
                    <!-- 2: Dosya Listesi -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 0: Windows 11 Adres Çubuğu & Arama Satırı (Tam Klasör Tasarımı) -->
                <Grid Grid.Row="0" Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <!-- Geri / İleri / Yukarı / Yenile Butonları -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Adres / Breadcrumb Bar (Esneyen) -->
                        <ColumnDefinition Width="*" />
                        <!-- Arama Kutusu -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Windows 11 Tarzı Gezinti Butonları (< > ^ ↻) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Button x:Name="BackButton" Click="BackButton_Click" IsEnabled="False" 
                                ToolTipService.ToolTip="Geri (Alt + Sol Ok)" Width="32" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <FontIcon Glyph="&#xE72B;" FontSize="12" />
                        </Button>
                        <Button x:Name="ForwardButton" Click="ForwardButton_Click" IsEnabled="False" 
                                ToolTipService.ToolTip="İleri (Alt + Sağ Ok)" Width="32" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <FontIcon Glyph="&#xE72A;" FontSize="12" />
                        </Button>
                        <Button x:Name="UpButton" Click="UpButton_Click" IsEnabled="False" 
                                ToolTipService.ToolTip="Üst Klasör (Alt + Yukarı Ok)" Width="32" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <FontIcon Glyph="&#xE74A;" FontSize="12" />
                        </Button>
                        <Button x:Name="NavRefreshButton" Click="RefreshButton_Click"
                                ToolTipService.ToolTip="Yenile (F5)" Width="32" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0" CornerRadius="4">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        </Button>
                    </StackPanel>

                    <!-- Adres Çubuğu Kutusu (Windows 11 File Explorer Birebir Tasarım) -->
                    <Border Grid.Column="1" 
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,0,8,0"
                            VerticalAlignment="Center"
                            Height="32">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="13" 
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" 
                                      Margin="0,0,6,0" VerticalAlignment="Center" />
                            <BreadcrumbBar x:Name="PathBreadcrumbBar" Grid.Column="1" 
                                           ItemClicked="PathBreadcrumbBar_ItemClicked"
                                           VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Windows 11 Arama Çubuğu -->
                    <AutoSuggestBox x:Name="SearchBox" 
                                    Grid.Column="2"
                                    Width="240"
                                    Height="32"
                                    Margin="6,0,0,0"
                                    PlaceholderText="HDrive içinde ara"
                                    QueryIcon="Find"
                                    VerticalAlignment="Center"
                                    CornerRadius="4"
                                    TextChanged="SearchBox_TextChanged"
                                    QuerySubmitted="SearchBox_QuerySubmitted" />
                </Grid>

                <!-- 1: Komut Çubuğu (Windows 11 Komut Şeridi & Üç Nokta Menüsü) -->
                <CommandBar Grid.Row="1" Background="Transparent" DefaultLabelPosition="Right" Margin="0,0,0,4" HorizontalAlignment="Left">
                    <AppBarButton Icon="NewFolder" Label="Yeni Klasör" Click="NewFolderButton_Click" />
                    <AppBarButton Icon="Upload" Label="Yükle" Click="UploadButton_Click" />
                    <AppBarButton Icon="Delete" Label="Sil" Click="ContextDelete_Click" ToolTipService.ToolTip="Seçili öğeleri sil (Delete)" />
                    <AppBarSeparator />
                    <AppBarButton Icon="View" Label="Görünüm">
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Büyük Simgeler" Click="ViewLarge_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE80A;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Orta Simgeler" Click="ViewMedium_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7F4;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Ayrıntılar" Click="ViewDetails_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C0;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarButton Label="Sırala">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8CB;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <ToggleMenuFlyoutItem x:Name="SortByNameItem" Text="Ad" IsChecked="True" Click="SortByName_Click" />
                                <ToggleMenuFlyoutItem x:Name="SortByDateItem" Text="Değiştirilme Tarihi" Click="SortByDate_Click" />
                                <ToggleMenuFlyoutItem x:Name="SortBySizeItem" Text="Boyut" Click="SortBySize_Click" />
                                <ToggleMenuFlyoutItem x:Name="SortByTypeItem" Text="Tür" Click="SortByType_Click" />
                                <MenuFlyoutSeparator />
                                <ToggleMenuFlyoutItem x:Name="SortAscItem" Text="Artan" IsChecked="True" Click="SortAscending_Click" />
                                <ToggleMenuFlyoutItem x:Name="SortDescItem" Text="Azalan" Click="SortDescending_Click" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarToggleButton x:Name="PreviewPaneToggle" Icon="PreviewLink" Label="Önizleme" Click="PreviewPaneToggle_Click" />
                    <AppBarSeparator />
                    <!-- Üç Nokta (...) Menüsü -->
                    <AppBarButton Label="Daha Fazla">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE712;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Yenile" Click="RefreshButton_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Şimdi Eşitle" Click="SyncNow_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE895;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Yerel Klasörü Aç" Click="OpenLocalFolder_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED43;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Tümünü Seç" Click="SelectAll_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B3;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Ayarlar" Click="OpenSettings_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                </CommandBar>

                <!-- 2: Dosya Gezgini İçerik Alanı ve Önizleme Bölmesi -->
                <Grid Grid.Row="2"
                      AllowDrop="True"
                      DragOver="FileArea_DragOver"
                      Drop="FileArea_Drop">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Sol Taraf: Dosya Görünümleri -->
                    <Grid Grid.Column="0">
                        <!-- Yükleniyor Halkası -->
                        <ProgressRing x:Name="LoadingRing" IsActive="False" Width="40" Height="40" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <!-- 1. Grid Görünümü: Büyük Simgeler (Windows 11 Yerel Gezgin Hover & Seçim Stili) -->
                        <GridView x:Name="FileGridView" 
                                  SelectionMode="Extended"
                                  SelectionChanged="FileList_SelectionChanged"
                                  DoubleTapped="FileList_DoubleTapped"
                                  KeyDown="FileList_KeyDown"
                                  RightTapped="FileItem_RightTapped"
                                  AllowDrop="True"
                                  DragOver="FileArea_DragOver"
                                  Drop="FileArea_Drop"
                                  Visibility="Visible">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="CornerRadius" Value="8" />
                                    <Setter Property="Margin" Value="3" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:FileItem">
                                    <Border Background="Transparent"
                                            CornerRadius="8"
                                            Width="120" Height="120"
                                            Padding="8" Margin="0"
                                            Tapped="Item_Tapped"
                                            DoubleTapped="Item_DoubleTapped"
                                            CanDrag="True"
                                            DragStarting="FileItem_DragStarting">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{x:Bind IconImage}" Width="48" Height="48" Stretch="Uniform"
                                                       Visibility="{x:Bind HasIconImageVisibility}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <FontIcon Glyph="{x:Bind GlyphIcon}" FontSize="40"
                                                          Foreground="{x:Bind IconBrush}"
                                                          Visibility="{x:Bind HasNoIconImageVisibility}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>

                                            <TextBlock Grid.Row="1" Text="{x:Bind Name}" 
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0" />

                                            <TextBlock Grid.Row="2" Text="{x:Bind FormattedSize}" 
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <!-- 2. Grid Görünümü: Orta Simgeler (96x96, Yerel Hover) -->
                        <GridView x:Name="FileGridViewMedium" 
                                  SelectionMode="Extended"
                                  SelectionChanged="FileList_SelectionChanged"
                                  DoubleTapped="FileList_DoubleTapped"
                                  KeyDown="FileList_KeyDown"
                                  RightTapped="FileItem_RightTapped"
                                  AllowDrop="True"
                                  DragOver="FileArea_DragOver"
                                  Drop="FileArea_Drop"
                                  Visibility="Collapsed">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="CornerRadius" Value="6" />
                                    <Setter Property="Margin" Value="2" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:FileItem">
                                    <Border Background="Transparent"
                                            CornerRadius="6"
                                            Width="92" Height="92"
                                            Padding="6" Margin="0"
                                            Tapped="Item_Tapped"
                                            DoubleTapped="Item_DoubleTapped"
                                            CanDrag="True"
                                            DragStarting="FileItem_DragStarting">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{x:Bind IconImage}" Width="36" Height="36" Stretch="Uniform"
                                                       Visibility="{x:Bind HasIconImageVisibility}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <FontIcon Glyph="{x:Bind GlyphIcon}" FontSize="30"
                                                          Foreground="{x:Bind IconBrush}"
                                                          Visibility="{x:Bind HasNoIconImageVisibility}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>

                                            <TextBlock Grid.Row="1" Text="{x:Bind Name}" 
                                                       FontWeight="Normal"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <!-- 3. Liste / Tablo Görünümü (Ayrıntılar - Yerel Dosya Gezgini Satır Hover Stili) -->
                        <ListView x:Name="FileListView"
                                  SelectionMode="Extended"
                                  SelectionChanged="FileList_SelectionChanged"
                                  DoubleTapped="FileList_DoubleTapped"
                                  KeyDown="FileList_KeyDown"
                                  RightTapped="FileItem_RightTapped"
                                  AllowDrop="True"
                                  DragOver="FileArea_DragOver"
                                  Drop="FileArea_Drop"
                                  Visibility="Collapsed">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="CornerRadius" Value="4" />
                                    <Setter Property="Margin" Value="4,1,4,1" />
                                    <Setter Property="MinHeight" Value="32" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.Header>
                                <Grid Padding="12,6,12,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ad" FontWeight="SemiBold" Tapped="HeaderSortByName_Tapped" />
                                    <TextBlock Grid.Column="1" Text="Değiştirilme Tarihi" FontWeight="SemiBold" Tapped="HeaderSortByDate_Tapped" />
                                    <TextBlock Grid.Column="2" Text="Tür" FontWeight="SemiBold" Tapped="HeaderSortByType_Tapped" />
                                    <TextBlock Grid.Column="3" Text="Boyut" FontWeight="SemiBold" TextAlignment="Right" Tapped="HeaderSortBySize_Tapped" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:FileItem">
                                    <Grid Padding="8,6,8,6"
                                          Background="Transparent"
                                          Tapped="Item_Tapped"
                                          DoubleTapped="Item_DoubleTapped"
                                          CanDrag="True"
                                          DragStarting="FileItem_DragStarting">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                                <Image Source="{x:Bind IconImageSmall}" Width="16" Height="16" Stretch="Uniform"
                                                       Visibility="{x:Bind HasIconImageVisibility}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <FontIcon Glyph="{x:Bind GlyphIcon}" FontSize="16" 
                                                          Foreground="{x:Bind IconBrush}"
                                                          Visibility="{x:Bind HasNoIconImageVisibility}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" 
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{x:Bind FormattedDate}" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        
                                        <TextBlock Grid.Column="2" Text="{x:Bind TypeDescription}" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        
                                        <TextBlock Grid.Column="3" Text="{x:Bind FormattedSize}" VerticalAlignment="Center"
                                                   TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Sağ Taraf: Windows 11 Önizleme Bölmesi (Preview Pane - PDF, Resim, Belge) -->
                    <Border x:Name="PreviewPane" Grid.Column="1"
                            Width="300" Margin="12,0,0,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <!-- Başlık & Kapat Butonu -->
                                <Grid>
                                    <TextBlock Text="Önizleme Bölmesi" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                    <Button HorizontalAlignment="Right" Click="ClosePreviewPane_Click" Padding="6,4" CornerRadius="4" ToolTipService.ToolTip="Önizlemeyi Kapat">
                                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                                    </Button>
                                </Grid>

                                <!-- Önizleme Görsel Kartı -->
                                <Border Height="180" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image x:Name="PreviewIconImage" Width="72" Height="72" Stretch="Uniform" Visibility="Collapsed" />
                                        <FontIcon x:Name="PreviewIcon" Glyph="&#xE8A5;" FontSize="72" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <Image x:Name="PreviewImage" Stretch="Uniform" MaxHeight="170" Visibility="Collapsed" />
                                    </Grid>
                                </Border>

                                <!-- Dosya Başlığı ve Tür Etiketi -->
                                <TextBlock x:Name="PreviewFileName" Text="Dosya Seçilmedi" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                                <Border x:Name="PreviewBadge" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center">
                                    <TextBlock x:Name="PreviewTypeBadge" Text="Bilinmeyen" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                </Border>

                                <MenuFlyoutSeparator Margin="0,2,0,2" />

                                <!-- Ayrıntılı Bilgi Alanı -->
                                <Grid RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Boyut:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    <TextBlock x:Name="PreviewSizeText" Grid.Row="0" Grid.Column="1" Text="--" FontWeight="SemiBold" FontSize="12" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Değiştirilme:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    <TextBlock x:Name="PreviewDateText" Grid.Row="1" Grid.Column="1" Text="--" FontSize="12" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Biçim:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    <TextBlock x:Name="PreviewExtensionText" Grid.Row="2" Grid.Column="1" Text="--" FontSize="12" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Konum:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    <TextBlock x:Name="PreviewPathText" Grid.Row="3" Grid.Column="1" Text="--" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>

                                <!-- Hızlı Eylemler -->
                                <StackPanel Spacing="8" Margin="0,8,0,0">
                                    <Button x:Name="PreviewOpenButton" Content="Varsayılan Uygulamayla Aç" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="PreviewOpenButton_Click" />
                                    <Button x:Name="PreviewDownloadButton" Content="İndir ve Kaydet" HorizontalAlignment="Stretch" Click="PreviewDownloadButton_Click" />
                                    <Button x:Name="PreviewDeleteButton" Content="Sil" Style="{ThemeResource SubtleButtonStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" HorizontalAlignment="Stretch" Click="ContextDelete_Click" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Sağ Tık Menüsü (Flyout) -->
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Aç" Click="ContextOpen_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8E5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="ContextPinItem" Text="Kenar Çubuğuna Sabitle" Click="ContextPin_Click" Visibility="Collapsed">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon x:Name="ContextPinIcon" Glyph="&#xE718;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="İndir" Click="ContextDownload_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE896;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Yeniden Adlandır (F2)" Click="ContextRename_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8AC;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Sil" Click="ContextDelete_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Grid.ContextFlyout>
                </Grid>
            </Grid>
        </NavigationView>

        <!-- 2: Windows Durum Çubuğu -->
        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Padding="16,0,16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ItemCountText" Grid.Column="0" Text="0 öğe" 
                           VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBlock x:Name="SyncStatusText" Grid.Column="1" Text="Eşitleme: Hazır" 
                           VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
